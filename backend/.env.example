# Copy to .env and fill in. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kl_electricals

# Generate a fresh one, do not reuse another project's:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000

# How long GPS pings are kept before scripts/purge-locations.js removes them.
# This is the only table that grows without bound. Deleting is irreversible —
# choose deliberately, since these rows are the only record of where an
# employee was.
LOCATION_RETENTION_DAYS=90

# The timezone the business actually works in. Instants are stored in UTC; this
# is what decides which calendar day a check-in belongs to, and what "today"
# means on the dashboard. IANA name.
BUSINESS_TIMEZONE=Asia/Kolkata

# Shifts left open are closed at this wall-clock time on their own day, in
# BUSINESS_TIMEZONE, and flagged is_auto_checkout. The server sweeps hourly;
# set AUTO_CHECKOUT_ENABLED=false to run scripts/auto-checkout.js yourself.
AUTO_CHECKOUT_TIME=19:00
AUTO_CHECKOUT_ENABLED=true

# Comma-separated list of allowed origins. Unset means every origin is accepted,
# which is only acceptable on a development LAN.
# CORS_ORIGIN=http://localhost:8081,http://192.168.1.20:8081

# ---------------------------------------------------------------------------
# Tally Prime (requirements section 14)
# ---------------------------------------------------------------------------
# Tally Prime exposes an HTTP/XML gateway on port 9000 when
# Gateway of Tally -> F1 -> Advanced Configuration -> "Act as Server" is Yes.
#
# OFF by default and deliberately so: a half-configured sync that pushes
# documents into the wrong company is worse than no sync at all. Documents are
# still queued while it is off, so nothing is lost — they go the moment it is
# switched on. Check both settings first with:
#   npm run tally -- --ping
TALLY_ENABLED=false
TALLY_HOST=127.0.0.1
TALLY_PORT=9000

# Must match the open company name in Tally EXACTLY. A mismatch is not an
# error: Tally accepts the request and imports nothing.
TALLY_COMPANY=

# How often the outbox is drained. This is what "real-time" means in practice.
TALLY_INTERVAL_MS=30000
TALLY_BATCH=50
TALLY_TIMEOUT_MS=15000

# The Tally ledger names vouchers post against. Defaults are Tally's own
# standard names; change them to match the chart of accounts in use.
TALLY_SALES_LEDGER=Sales
TALLY_PURCHASE_LEDGER=Purchase
TALLY_GST_LEDGER=Output GST
TALLY_INPUT_GST_LEDGER=Input GST
TALLY_CASH_LEDGER=Cash
TALLY_BANK_LEDGER=Bank
TALLY_DEBTOR_GROUP=Sundry Debtors
TALLY_ITEM_GROUP=Primary

# ---------------------------------------------------------------------------
# Reverse geocoding (requirements D.2)
# ---------------------------------------------------------------------------
# Turns an order's GPS fix into a place name. OFF by default because it means
# sending an identified employee's exact coordinates to a third party, in an app
# that already tracks named people through the working day. That is a decision
# for the business to take deliberately, not a default.
#
# With it off, the place name the client supplies is used and the order records
# gps_place_source = 'client' so the difference is visible.
#
# GEOCODE_HOST can point at a self-hosted Nominatim, which is the better answer
# if staff positions should not leave the premises at all. Nominatim's usage
# policy requires a real contact address in the User-Agent.
GEOCODE_ENABLED=false
GEOCODE_HOST=nominatim.openstreetmap.org
GEOCODE_USER_AGENT=KLElectricalsApp/1.0 (klelectricals@gmail.com)
GEOCODE_TIMEOUT_MS=4000

# Set ALERTS_ENABLED=false to run scripts/run-alerts.js from Task Scheduler
# instead of the server's own hourly sweep.
ALERTS_ENABLED=true

# ---------------------------------------------------------------------------
# Punch-time order checks (September 2026 sheet, section 4.2)
# ---------------------------------------------------------------------------
# v1 required Manas to approve every order and Sonu to verify every pick.
# Both are now automatic unless a real exception fires, and two of those
# exceptions are numbers the sheet leaves to the business rather than stating:
#
#   ORDER_APPROVAL_VALUE_THRESHOLD        an order above this value routes to
#                                         Manas's approval queue instead of
#                                         going straight to picking
#   VERIFICATION_HIGH_VALUE_THRESHOLD     a line above this per-unit rate
#                                         routes the order to Sonu's count
#                                         instead of auto-verifying
#
# 0 or unset disables that leg of the check rather than flagging everything —
# an invented placeholder would be indistinguishable from a real decision, so
# there isn't one here. Set both once Yash names real figures.
ORDER_APPROVAL_VALUE_THRESHOLD=0
VERIFICATION_HIGH_VALUE_THRESHOLD=0

# Billing's own exception-review triggers, same treatment: 0/unset disables
# that leg rather than flagging everything.
#   BILL_REVIEW_DISCOUNT_THRESHOLD       a line discount above this % flags
#                                        the invoice for Sibu's review
#   BILL_REVIEW_CREDIT_VALUE_THRESHOLD   a credit/debit note above this
#                                        value flags it for Sibu's review
BILL_REVIEW_DISCOUNT_THRESHOLD=0
BILL_REVIEW_CREDIT_VALUE_THRESHOLD=0
